{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCCareMasterPro",
  "version": "2.0.0-alpha.1",
  "identifier": "com.thienphat.techtoolkit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PCCareMasterPro - Thien Phat Tech Toolkit",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENzM5NENFOUM2MUM2ODEKUldTQnhtR2N6cFJ6dlhFNG8wZmVTSUtlUExreFpRZ1lEN09uRFU0U2lmUFFneFYrSHRTd0FjaDUK",
      "endpoints": [
        "https://github.com/thangdggr0004-cpu/PCCarePro/releases/download/v2.0.0-alpha.1/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
